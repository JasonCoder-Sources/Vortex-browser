class SplitViewDialog(QDialog):

    def __init__(self, tabs, current_index=0, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Choose split-view tabs")
        self.setMinimumWidth(400)

        layout = QVBoxLayout(self)

        intro = QLabel(
            "Choose two different tabs to display side by side."
        )
        intro.setWordWrap(True)
        layout.addWidget(intro)

        form = QFormLayout()
        self.left_combo = QComboBox()
        self.right_combo = QComboBox()

        for index, title, url in tabs:
            label = f"{title}  —  {url[:65]}"
            self.left_combo.addItem(label, index)
            self.right_combo.addItem(label, index)

        left_position = self.left_combo.findData(current_index)
        if left_position >= 0:
            self.left_combo.setCurrentIndex(left_position)

        right_position = 1 if self.right_combo.count() > 1 else 0
        self.right_combo.setCurrentIndex(right_position)

        form.addRow("Left tab:", self.left_combo)
        form.addRow("Right tab:", self.right_combo)
        layout.addLayout(form)

        buttons = QDialogButtonBox(
            QDialogButtonBox.StandardButton.Ok
            | QDialogButtonBox.StandardButton.Cancel
        )
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def selected_indices(self):
        return (
            self.left_combo.currentData(),
            self.right_combo.currentData(),
        )


