    def handle_download(self, download):
        suggested = download.suggestedFileName() or "download"

        destination, _ = QFileDialog.getSaveFileName(
            self,
            "Save Download",
            os.path.join(DOWNLOAD_DIR, suggested),
        )

        if not destination:
            download.cancel()
            return

        directory = os.path.dirname(destination)
        filename = os.path.basename(destination)

        download.setDownloadDirectory(directory)
        download.setDownloadFileName(filename)

        download.downloadProgress.connect(
            lambda received, total, d=download:
                self.statusBar().showMessage(
                    f"Downloading {d.downloadFileName()}: "
                    f"{received / total * 100:.0f}%"
                    if total > 0 else
                    f"Downloading {d.downloadFileName()}",
                    3000,
                )
        )

        download.stateChanged.connect(
            lambda state, d=download:
                self._download_state_changed(d, state)
        )

        download.accept()

    def _download_state_changed(self, download, state):
        if state == QWebEngineDownloadRequest.DownloadState.DownloadCompleted:
            self.statusBar().showMessage(
                f"Download complete: {download.downloadFileName()}",
                5000,
            )
        elif state == QWebEngineDownloadRequest.DownloadState.DownloadCancelled:
            self.statusBar().showMessage("Download cancelled", 3000)
        elif state == QWebEngineDownloadRequest.DownloadState.DownloadInterrupted:
            self.statusBar().showMessage("Download interrupted", 5000)

    def show_downloads(self):
        try:
            os.startfile(DOWNLOAD_DIR)
        except AttributeError:
            import subprocess
            import platform

            if platform.system() == "Darwin":
                subprocess.Popen(["open", DOWNLOAD_DIR])
            else:
                subprocess.Popen(["xdg-open", DOWNLOAD_DIR])
        except OSError as error:
            QMessageBox.warning(self, "Downloads", str(error))

