    def choose_split_tabs(self):
        if len(self.views) < 2:
            QMessageBox.information(
                self,
                "Split View",
                "Open at least two tabs before using split view.",
            )
            return

        tab_data = []

        for index, view in enumerate(self.views):
            title = self.view_titles.get(view, "New Tab")
            url = view.url().toString()
            tab_data.append((index, title, url))

        dialog = SplitViewDialog(
            tab_data,
            self.tab_bar.currentIndex(),
            self,
        )

        if dialog.exec() != QDialog.DialogCode.Accepted:
            return

        left_index, right_index = dialog.selected_indices()

        if left_index == right_index:
            QMessageBox.warning(
                self,
                "Split View",
                "Choose two different tabs.",
            )
            return

        left_view = self.views[left_index]
        right_view = self.views[right_index]

        self.enter_split_view(left_view, right_view)

    def enter_split_view(self, left_view, right_view):
        self.exit_split_view(rebuild=False)

        self.split_active = True
        self.split_left_view = left_view
        self.split_right_view = right_view

        # Move the actual existing browser widgets into the splitter.
        # The pages are not reloaded, so their state is preserved.
        self.splitter = QSplitter(Qt.Orientation.Horizontal)
        self.splitter.setChildrenCollapsible(False)
        self.splitter.setHandleWidth(5)

        self.page_stack.removeWidget(left_view)
        self.page_stack.removeWidget(right_view)

        self.splitter.addWidget(left_view)
        self.splitter.addWidget(right_view)
        self.splitter.setSizes([1, 1])

        self.content_stack.addWidget(self.splitter)
        self.content_stack.setCurrentWidget(self.splitter)

        self.active_view = left_view
        self.address_bar.setText(left_view.url().toString())

        self.statusBar().showMessage(
            "Split View — choose another pair from the menu anytime"
        )

    def exit_split_view(self, rebuild=True):
        if not self.split_active:
            return

        left_view = self.split_left_view
        right_view = self.split_right_view
        splitter = self.splitter

        self.split_active = False
        self.split_left_view = None
        self.split_right_view = None
        self.splitter = None

        if splitter:
            splitter.removeWidget(left_view)
            splitter.removeWidget(right_view)
            self.content_stack.removeWidget(splitter)
            splitter.deleteLater()

        if left_view in self.views and self.page_stack.indexOf(left_view) < 0:
            self.page_stack.addWidget(left_view)

        if right_view in self.views and self.page_stack.indexOf(right_view) < 0:
            self.page_stack.addWidget(right_view)

        # Rebuild stack order from the visible tab-bar order.
        for view in self.views:
            if self.page_stack.indexOf(view) < 0:
                self.page_stack.addWidget(view)

        if rebuild:
            index = self.tab_bar.currentIndex()
            if 0 <= index < len(self.views):
                self.switch_tab(index)
            else:
                self.content_stack.setCurrentWidget(self.normal_stack)

