    # --------------------------------------------------------

    def show_history(self):
        dialog = QDialog(self)
        dialog.setWindowTitle("Browsing History")
        dialog.resize(750, 450)

        layout = QVBoxLayout(dialog)
        search = QLineEdit()
        search.setPlaceholderText("Search history...")
        listing = QListWidget()

        layout.addWidget(search)
        layout.addWidget(listing)

        def refresh():
            listing.clear()
            query = search.text().lower()

            for entry in reversed(self.history):
                title = entry.get("title", "")
                url = entry.get("url", "")

                if query and query not in title.lower() and query not in url.lower():
                    continue

                listing.addItem(f"{title} — {url}")

        search.textChanged.connect(refresh)
        refresh()

        row = QHBoxLayout()
        open_button = QPushButton("Open")
        clear_button = QPushButton("Clear History")
        close_button = QPushButton("Close")

        row.addWidget(open_button)
        row.addWidget(clear_button)
        row.addStretch()
        row.addWidget(close_button)
        layout.addLayout(row)

        def open_selected():
            index = listing.currentRow()
            entries = [
                e for e in reversed(self.history)
                if not search.text().lower()
                or search.text().lower() in e.get("title", "").lower()
                or search.text().lower() in e.get("url", "").lower()
            ]

            if 0 <= index < len(entries):
                self.new_tab(url=entries[index]["url"])
                dialog.accept()

        def clear_history():
            answer = QMessageBox.question(
                dialog,
                "Clear history",
                "Clear all browsing history?",
            )

            if answer == QMessageBox.StandardButton.Yes:
                self.history.clear()
                if not self.incognito:
                    save_json(HISTORY_FILE, self.history)
                refresh()

        open_button.clicked.connect(open_selected)
        clear_button.clicked.connect(clear_history)
        close_button.clicked.connect(dialog.accept)
        listing.itemDoubleClicked.connect(lambda _: open_selected())

        dialog.exec()

