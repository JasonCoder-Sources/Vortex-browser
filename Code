    def zoom_in(self):
        self.change_zoom(10)

    def zoom_out(self):
        self.change_zoom(-10)

    def reset_zoom(self):
        view = self.current_view()
        if view:
            view.setZoomFactor(1.0)
            self.zoom_levels[view] = 100

    def change_zoom(self, amount):
        view = self.current_view()
        if not view:
            return

        current = round(view.zoomFactor() * 100)
        value = max(30, min(250, current + amount))

        view.setZoomFactor(value / 100.0)
        self.zoom_levels[view] = value

        self.statusBar().showMessage(f"Zoom: {value}%", 1500)

