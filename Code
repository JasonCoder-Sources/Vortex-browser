class VortexBrowser(QMainWindow):

    def __init__(self, incognito=False):
        super().__init__()

        self.incognito = incognito
        self.settings_data = load_json(
            SETTINGS_FILE,
            DEFAULT_SETTINGS.copy(),
        )

        for key, value in DEFAULT_SETTINGS.items():
            self.settings_data.setdefault(key, value)

        self.bookmarks = (
            [] if incognito else load_json(BOOKMARKS_FILE, [])
        )
        self.history = (
            [] if incognito else load_json(HISTORY_FILE, [])
        )

        self.views = []
        self.view_titles = {}
        self.view_urls = {}
        self.zoom_levels = {}
        self.pending_popups = []
        self.split_active = False
        self.split_left_view = None
        self.split_right_view = None
        self.splitter = None

        self.setWindowTitle(
            "VORTEX — Incognito" if incognito else "VORTEX Browser"
        )
        self.resize(1360, 850)
        self.setMinimumSize(760, 500)

        self._create_profile()
        self._build_interface()
        self._setup_shortcuts()
        self.apply_theme()

        self.profile.downloadRequested.connect(self.handle_download)

        if not incognito and self.settings_data.get("restore_session", True):
            session = load_json(SESSION_FILE, {})
            urls = session.get("tabs", [])

            if urls:
                for url in urls:
                    self.new_tab(url=url, switch=False)
                index = min(
                    session.get("current", 0),
                    max(0, len(self.views) - 1),
                )
                if self.views:
                    self.switch_tab(index)
            else:
                self.new_tab()
        else:
            self.new_tab()

    # --------------------------------------------------------
    # PROFILE
    # --------------------------------------------------------

    def _create_profile(self):
        if self.incognito:
            self.profile = QWebEngineProfile(self)
            self.profile.setHttpCacheType(
                QWebEngineProfile.HttpCacheType.MemoryHttpCache
            )
            self.profile.setPersistentCookiesPolicy(
                QWebEngineProfile.PersistentCookiesPolicy.NoPersistentCookies
            )
        else:
            self.profile = QWebEngineProfile("VortexProfile", self)
            self.profile.setPersistentStoragePath(PROFILE_DIR)
            self.profile.setCachePath(CACHE_DIR)
            self.profile.setHttpCacheType(
                QWebEngineProfile.HttpCacheType.DiskHttpCache
            )
            self.profile.setPersistentCookiesPolicy(
                QWebEngineProfile.PersistentCookiesPolicy.AllowPersistentCookies
            )

    # --------------------------------------------------------
    # INTERFACE
    # --------------------------------------------------------

    def _build_interface(self):
        central = QWidget()
        self.setCentralWidget(central)

        main_layout = QVBoxLayout(central)
        main_layout.setContentsMargins(5, 5, 5, 0)
        main_layout.setSpacing(3)

        # Tab strip is the topmost browser row.
        tab_row = QHBoxLayout()
        tab_row.setSpacing(3)

        self.tab_bar = QTabBar()
        self.tab_bar.setMovable(True)
        self.tab_bar.setTabsClosable(True)
        self.tab_bar.setExpanding(False)
        self.tab_bar.setDocumentMode(True)
        self.tab_bar.currentChanged.connect(self.switch_tab)
        self.tab_bar.tabCloseRequested.connect(self.close_tab)
        self.tab_bar.tabMoved.connect(self._on_tab_moved)

        tab_row.addWidget(self.tab_bar, 1)

        self.add_tab_button = QToolButton()
        self.add_tab_button.setText("+")
        self.add_tab_button.setToolTip("New tab (Ctrl+T)")
        self.add_tab_button.setFixedSize(32, 31)
        self.add_tab_button.setStyleSheet(
            "QToolButton { font-size: 18px; font-weight: bold; }"
        )
        self.add_tab_button.clicked.connect(self.new_tab)
        tab_row.addWidget(self.add_tab_button)

        main_layout.addLayout(tab_row)

        # Address/navigation bar directly below the tabs.
        nav_row = QHBoxLayout()
        nav_row.setSpacing(4)

        self.back_button = self._tool_button("←", "Back")
        self.forward_button = self._tool_button("→", "Forward")
        self.reload_button = self._tool_button("↻", "Reload")
        self.home_button = self._tool_button("⌂", "Home")

        self.back_button.clicked.connect(self.go_back)
        self.forward_button.clicked.connect(self.go_forward)
        self.reload_button.clicked.connect(self.reload_page)
        self.home_button.clicked.connect(self.go_home)

        nav_row.addWidget(self.back_button)
        nav_row.addWidget(self.forward_button)
        nav_row.addWidget(self.reload_button)
        nav_row.addWidget(self.home_button)

        self.address_bar = QLineEdit()
        self.address_bar.setPlaceholderText("Search or enter address")
        self.address_bar.setClearButtonEnabled(True)
        self.address_bar.returnPressed.connect(self.navigate)
        self.address_bar.setMinimumHeight(34)
        nav_row.addWidget(self.address_bar, 1)

        self.bookmark_button = self._tool_button("☆", "Bookmark this page")
        self.bookmark_button.clicked.connect(self.add_bookmark)
        nav_row.addWidget(self.bookmark_button)

        self.menu_button = self._tool_button("⋮", "Browser menu")
        self.menu_button.setFixedWidth(34)
        self.menu_button.clicked.connect(self.show_browser_menu)
        nav_row.addWidget(self.menu_button)

        main_layout.addLayout(nav_row)

        # The progress bar replaces noisy "Page ready" text.
