        dialog.setWindowTitle("Bookmarks")
        dialog.resize(600, 400)

        layout = QVBoxLayout(dialog)
        listing = QListWidget()

        for item in self.bookmarks:
            listing.addItem(
                f"{item.get('title', 'Untitled')} — {item.get('url', '')}"
            )

        layout.addWidget(listing)

