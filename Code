    # SESSION RESTORATION
    # --------------------------------------------------------

    def save_session(self):
        if self.incognito:
            return

        urls = [
            view.url().toString()
            for view in self.views
        ]

        save_json(SESSION_FILE, {
            "tabs": urls,
            "current": max(0, self.tab_bar.currentIndex()),
        })

    # --------------------------------------------------------
    # WINDOW CLOSE
    # --------------------------------------------------------

    def closeEvent(self, event):
        self.save_session()

        if self.split_active:
            self.exit_split_view()

        event.accept()


# ============================================================
# START APPLICATION
# ============================================================

def main():
    QApplication.setApplicationName("VORTEX")
    QApplication.setOrganizationName("VORTEX")

    app = QApplication(sys.argv)
    app.setStyle("Fusion")

    browser = VortexBrowser()
    browser.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
