def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return default


def save_json(path, data):
    try:
        temp = path + ".tmp"
        with open(temp, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        os.replace(temp, path)
    except OSError as error:
        print("VORTEX save error:", error)


def normalize_url(text, search_engine="Google"):
    text = text.strip()

    if not text:
        return QUrl("about:blank")

    if text.startswith(("about:", "file:", "data:")):
        return QUrl(text)

    if re.match(r"^[a-zA-Z][a-zA-Z0-9+.-]*://", text):
        return QUrl(text)

    if " " not in text:
        first_part = text.split("/")[0]
        if "." in first_part or first_part.startswith("localhost"):
            if first_part.startswith("localhost"):
                return QUrl("http://" + text)
            return QUrl("https://" + text)

    engines = {
        "Google": "https://www.google.com/search?q=",
        "Bing": "https://www.bing.com/search?q=",
        "DuckDuckGo": "https://duckduckgo.com/?q=",
        "Brave": "https://search.brave.com/search?q=",
    }

    base = engines.get(search_engine, engines["Google"])
    return QUrl(base + quote_plus(text))


