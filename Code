        self.progress_bar.setFixedHeight(3)
        self.progress_bar.hide()
        main_layout.addWidget(self.progress_bar)

        # Main content: normal tab stack or two-way split.
        self.content_stack = QStackedWidget()
        main_layout.addWidget(self.content_stack, 1)

        self.normal_stack = QWidget()
        self.normal_layout = QVBoxLayout(self.normal_stack)
        self.normal_layout.setContentsMargins(0, 0, 0, 0)
        self.normal_layout.setSpacing(0)

        self.page_stack = QStackedWidget()
        self.normal_layout.addWidget(self.page_stack, 1)

        self.content_stack.addWidget(self.normal_stack)
        self.content_stack.setCurrentWidget(self.normal_stack)

        # Find bar, initially hidden.
        self.find_bar = QWidget()
        find_layout = QHBoxLayout(self.find_bar)
        find_layout.setContentsMargins(3, 3, 3, 3)

        find_layout.addWidget(QLabel("Find:"))

        self.find_input = QLineEdit()
        self.find_input.setPlaceholderText("Find on this page")
        self.find_input.returnPressed.connect(self.find_next)
        find_layout.addWidget(self.find_input, 1)

        self.find_status = QLabel("")
        find_layout.addWidget(self.find_status)

        find_next_button = QPushButton("Next")
        find_next_button.clicked.connect(self.find_next)
        find_layout.addWidget(find_next_button)

        find_prev_button = QPushButton("Previous")
        find_prev_button.clicked.connect(self.find_previous)
        find_layout.addWidget(find_prev_button)

        close_find_button = QToolButton()
        close_find_button.setText("×")
        close_find_button.clicked.connect(self.hide_find_bar)
        find_layout.addWidget(close_find_button)

        self.find_bar.hide()
        main_layout.addWidget(self.find_bar)

        self.setStatusBar(QStatusBar())
        self.statusBar().showMessage("VORTEX")

        # Track which page currently has keyboard focus.
        self.active_view = None

    def _tool_button(self, text, tooltip):
        button = QToolButton()
        button.setText(text)
        button.setToolTip(tooltip)
        button.setAutoRaise(False)
        button.setFixedHeight(32)
        return button

    # --------------------------------------------------------
    # SHORTCUTS
    # --------------------------------------------------------

    def _shortcut(self, key, callback):
        shortcut = QShortcut(QKeySequence(key), self)
        shortcut.activated.connect(callback)

    def _setup_shortcuts(self):
        self._shortcut("Ctrl+T", self.new_tab)
        self._shortcut("Ctrl+W", self.close_current_tab)
        self._shortcut("Ctrl+L", self.focus_address)
        self._shortcut("Alt+D", self.focus_address)
        self._shortcut("Ctrl+R", self.reload_page)
        self._shortcut("F5", self.reload_page)
        self._shortcut("Alt+Left", self.go_back)
        self._shortcut("Alt+Right", self.go_forward)
        self._shortcut("Ctrl+F", self.show_find_bar)
        self._shortcut("Ctrl+D", self.add_bookmark)
        self._shortcut("Ctrl+J", self.show_downloads)
        self._shortcut("Ctrl+Shift+N", self.open_incognito)
        self._shortcut("Ctrl+Plus", self.zoom_in)
        self._shortcut("Ctrl+=", self.zoom_in)
        self._shortcut("Ctrl+-", self.zoom_out)
        self._shortcut("Ctrl+0", self.reset_zoom)
        self._shortcut("Ctrl+Shift+S", self.choose_split_tabs)
        self._shortcut("Ctrl+Tab", self.next_tab)
        self._shortcut("Ctrl+Shift+Tab", self.previous_tab)

    # --------------------------------------------------------
    # WEB VIEWS
    # --------------------------------------------------------

    def _configure_page(self, view):
        view.setPage(VortexPage(self.profile, self, view))

        settings = view.settings()
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.JavascriptEnabled, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.JavascriptCanOpenWindows, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.LocalStorageEnabled, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.FullScreenSupportEnabled, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.ScrollAnimatorEnabled, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.ErrorPageEnabled, True
        )
        settings.setAttribute(
            QWebEngineSettings.WebAttribute.PluginsEnabled, True
        )

        view.urlChanged.connect(
            lambda url, v=view: self._url_changed(v, url)
        )
        view.titleChanged.connect(
            lambda title, v=view: self._title_changed(v, title)
        )
        view.loadProgress.connect(
            lambda progress, v=view: self._load_progress(v, progress)
        )
        view.loadStarted.connect(
            lambda v=view: self._load_started(v)
        )
        view.loadFinished.connect(
            lambda ok, v=view: self._load_finished(v, ok)
        )

        view.setZoomFactor(
            self.settings_data.get("zoom", 100) / 100.0
        )

        return view

    def create_view(self):
        view = QWebEngineView()
        self._configure_page(view)

        self.views.append(view)
        self.view_titles[view] = "New Tab"
        self.view_urls[view] = ""
        self.zoom_levels[view] = self.settings_data.get("zoom", 100)

        view.installEventFilter(self)
        view.focusInEvent = self._make_focus_handler(view, view.focusInEvent)

        return view

    def _make_focus_handler(self, view, original_handler):
        def handler(event):
            self.active_view = view
            original_handler(event)
            self._update_navigation_buttons()
        return handler

    def eventFilter(self, obj, event):
        if event.type() == event.Type.MouseButtonPress:
            if obj in self.views:
                self.active_view = obj
        return super().eventFilter(obj, event)

    # --------------------------------------------------------
    # NEW TABS AND POPUPS
    # --------------------------------------------------------

    def new_tab(self, checked=False, url=None, switch=True):
        view = self.create_view()
        index = self.tab_bar.addTab("New Tab")

        self.page_stack.addWidget(view)

        if switch:
            self.tab_bar.setCurrentIndex(index)
            self.switch_tab(index)

        if url:
            self.load_url_in_view(view, url)
        else:
            self.show_home(view)

        return view

    def create_popup_page(self, window_type):
        """
        Called by QWebEngine when a page uses target=_blank,
        window.open(), or a similar new-window navigation.

        Return a page belonging to a new VORTEX tab so that
        the website's requested navigation can continue.
        """
        view = self.new_tab(switch=True)

        if view is None:
            return None

        page = view.page()
        self.active_view = view

        return page

    def _on_tab_moved(self, from_index, to_index):
        # Keep page_stack in the same order as the tab bar.
        if from_index == to_index:
            return

        widget = self.page_stack.widget(from_index)
        if widget is None:
            return

        self.page_stack.removeWidget(widget)
        self.page_stack.insertWidget(to_index, widget)

        # Rebuild our view list to match the visual tab order.
        self.views = [
            self.page_stack.widget(i)
            for i in range(self.page_stack.count())
        ]

        self.switch_tab(self.tab_bar.currentIndex())

    def switch_tab(self, index):
        if index < 0 or index >= len(self.views):
            return

        view = self.views[index]
        self.active_view = view

        if self.page_stack.indexOf(view) >= 0:
            self.page_stack.setCurrentWidget(view)

        if not self.split_active:
            self.content_stack.setCurrentWidget(self.normal_stack)

        self.address_bar.setText(view.url().toString())
        self._update_navigation_buttons()

    def close_tab(self, index):
        if not 0 <= index < len(self.views):
            return

        view = self.views[index]

        if self.split_active and (
            view is self.split_left_view or
            view is self.split_right_view
        ):
            self.exit_split_view()

        self.views.remove(view)
        self.view_titles.pop(view, None)
        self.view_urls.pop(view, None)
        self.zoom_levels.pop(view, None)

        self.page_stack.removeWidget(view)
        self.tab_bar.removeTab(index)
        view.deleteLater()

        if not self.views:
            self.new_tab()
            return

        new_index = min(index, len(self.views) - 1)
        self.tab_bar.setCurrentIndex(new_index)
        self.switch_tab(new_index)

    def close_current_tab(self):
        self.close_tab(self.tab_bar.currentIndex())

    def next_tab(self):
        if self.views:
            index = (self.tab_bar.currentIndex() + 1) % len(self.views)
            self.tab_bar.setCurrentIndex(index)

    def previous_tab(self):
        if self.views:
            index = (self.tab_bar.currentIndex() - 1) % len(self.views)
            self.tab_bar.setCurrentIndex(index)

    # --------------------------------------------------------
    # NAVIGATION
    # --------------------------------------------------------

    def current_view(self):
        if self.active_view in self.views:
            return self.active_view

        index = self.tab_bar.currentIndex()

        if 0 <= index < len(self.views):
            return self.views[index]

        return None

    def navigate(self):
        view = self.current_view()

        if not view:
            return

        url = normalize_url(
            self.address_bar.text(),
            self.settings_data.get("search_engine", "Google"),
        )

        self.load_url_in_view(view, url)

    def load_url_in_view(self, view, url):
        if isinstance(url, str):
            url = QUrl(url)

        if url.toString() == "vortex://home":
            self.show_home(view)
            return

        view.setUrl(url)

    def show_home(self, view=None):
        if view is None:
            view = self.current_view()

        if not view:
            return

        home_type = self.settings_data.get("home_page", "vortex")

        if home_type == "custom":
            view.setUrl(QUrl(self.settings_data.get(
                "custom_home", "https://www.google.com"
            )))
        else:
            view.setHtml(
                home_html(self.settings_data.get("theme", "dark")),
                QUrl("https://vortex.home/")
            )

    def go_home(self):
        self.show_home(self.current_view())

    def go_back(self):
        view = self.current_view()
        if view:
            view.back()

    def go_forward(self):
        view = self.current_view()
        if view:
            view.forward()

    def reload_page(self):
        view = self.current_view()
        if view:
            view.reload()

    def focus_address(self):
        self.address_bar.setFocus()
        self.address_bar.selectAll()

    def _url_changed(self, view, url):
        self.view_urls[view] = url.toString()

        if view is self.current_view() and not self.split_active:
            self.address_bar.setText(url.toString())

        self._update_navigation_buttons()

    def _title_changed(self, view, title):
        title = title.strip() or "New Tab"
        self.view_titles[view] = title

        index = self.page_stack.indexOf(view)

        if index >= 0:
            self.tab_bar.setTabText(index, title[:24])
            self.tab_bar.setTabToolTip(index, title)

        if view is self.current_view():
            self.setWindowTitle(f"{title} — VORTEX")

    def _load_started(self, view):
        if view is self.current_view():
            self.progress_bar.setValue(0)
            self.progress_bar.show()

    def _load_progress(self, view, progress):
        if view is self.current_view():
            self.progress_bar.setValue(progress)

    def _load_finished(self, view, success):
        if view is self.current_view():
            self.progress_bar.hide()

        if success and not self.incognito:
            url = view.url().toString()
            title = view.title() or url

            if url and not url.startswith(("about:", "data:")):
                self.history.append({
                    "title": title,
                    "url": url,
                    "time": int(time.time()),
                })
                self.history = self.history[-3000:]
                save_json(HISTORY_FILE, self.history)

        self._update_navigation_buttons()

    def _update_navigation_buttons(self):
        view = self.current_view()

        if not view:
            return

        self.back_button.setEnabled(view.history().canGoBack())
        self.forward_button.setEnabled(view.history().canGoForward())

