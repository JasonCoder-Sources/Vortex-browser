class VortexPage(QWebEnginePage):
    """
    Pages created by target=_blank and window.open are routed
    through the browser's tab-creation callback.

    This is particularly useful for web apps that open projects,
    documents or other content in a new tab.
    """

    def __init__(self, profile, browser, parent=None):
        super().__init__(profile, parent)
        self.browser = browser

    def createWindow(self, window_type):
        if self.browser is None:
            return None

        return self.browser.create_popup_page(window_type)


