# ============================================================
# ENCRYPTED PASSWORD VAULT
# ============================================================

class PasswordVault:

    def __init__(self):
        self.entries = []
        self.fernet = None
        self.salt = None

    @staticmethod
    def derive_key(password, salt):
        key = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            salt,
            600_000,
            dklen=32
        )

        return base64.urlsafe_b64encode(key)

    def unlock(self, parent):

        # Existing vault
        if os.path.exists(VAULT_FILE):

            try:
                with open(VAULT_FILE, "r", encoding="utf-8") as file:
                    saved = json.load(file)

                self.salt = base64.b64decode(saved["salt"])

                password, ok = QInputDialog.getText(
                    parent,
                    "Unlock Password Vault",
                    "Enter your master password:",
                    QLineEdit.EchoMode.Password
                )

                if not ok or not password:
                    return False

                candidate = Fernet(
                    self.derive_key(password, self.salt)
                )

                try:
                    plaintext = candidate.decrypt(
                        saved["data"].encode("ascii")
                    )

                    self.entries = json.loads(
                        plaintext.decode("utf-8")
                    )

                except (InvalidToken, ValueError, json.JSONDecodeError):
                    QMessageBox.warning(
                        parent,
                        "Incorrect Password",
                        "The vault could not be unlocked. "
                        "Check your master password."
                    )
                    return False

                self.fernet = candidate
                return True

            except (OSError, KeyError, TypeError, ValueError):
                QMessageBox.warning(
                    parent,
                    "Vault Error",
                    "The password vault could not be read."
                )
                return False

        # Create a new vault
        password, ok = QInputDialog.getText(
            parent,
            "Create Password Vault",
            "Create a strong master password (12+ characters):",
            QLineEdit.EchoMode.Password
        )

        if not ok:
            return False

        if len(password) < 12:
            QMessageBox.warning(
                parent,
                "Password Too Short",
                "Use at least 12 characters."
            )
            return False

        confirm, ok = QInputDialog.getText(
            parent,
            "Confirm Master Password",
            "Enter your master password again:",
            QLineEdit.EchoMode.Password
        )

        if not ok:
            return False

        if password != confirm:
            QMessageBox.warning(
                parent,
                "Passwords Do Not Match",
                "The passwords you entered do not match."
            )
            return False

        self.salt = secrets.token_bytes(16)

        self.fernet = Fernet(
            self.derive_key(password, self.salt)
        )

        self.entries = []

        if not self.save():
            self.fernet = None

            QMessageBox.warning(
                parent,
                "Save Failed",
                "Could not create the password vault."
            )

            return False

        return True

    def save(self):

        if self.fernet is None or self.salt is None:
            return False

        encrypted = self.fernet.encrypt(
            json.dumps(self.entries).encode("utf-8")
        )

        payload = {
            "salt": base64.b64encode(
                self.salt
            ).decode("ascii"),

            "data": encrypted.decode("ascii")
        }

        temporary_file = VAULT_FILE + ".tmp"

        try:
            with open(
                temporary_file, "w", encoding="utf-8"
            ) as file:
                json.dump(payload, file)

            os.replace(temporary_file, VAULT_FILE)
            return True

        except OSError:
            try:
                if os.path.exists(temporary_file):
                    os.remove(temporary_file)
            except OSError:
                pass

            return False


# ============================================================
# BROWSER VIEW
