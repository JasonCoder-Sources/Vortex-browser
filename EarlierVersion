    # ========================================================
    # TABS
    # ========================================================

    def current_tab(self):

        tab = self.tabs.currentWidget()

        if tab is None:
            self.new_tab()
            tab = self.tabs.currentWidget()

        return tab

    def current_view(self):
        return self.current_tab().active

    def new_tab(self):

        tab = BrowserTab(self.profile, self)

        index = self.tabs.addTab(tab, "New Tab")
        self.tabs.setCurrentIndex(index)

        tab.primary.setUrl(QUrl(HOME_URL))
        tab.primary.setFocus()

        self.split_button.setText("◫ Split")

    def update_tab_title(self, tab, title):

        index = self.tabs.indexOf(tab)

        if index >= 0:
            self.tabs.setTabText(
                index, (title or "New Tab")[:22]
            )

    def update_address(self, index):

        tab = self.tabs.widget(index)

        if tab:
            self.address.setText(
                tab.active.url().toString()
            )

            self.split_button.setText(
                "◫ Close Split"
                if tab.secondary
                else "◫ Split"
            )

    def close_current_tab(self):
        self.close_tab(self.tabs.currentIndex())

    def close_tab(self, index):

        if index < 0:
            return

        tab = self.tabs.widget(index)

        if tab is None:
            return

        if self.tabs.count() <= 1:

            tab.primary.setUrl(QUrl(HOME_URL))

            if tab.secondary:
                tab.toggle_split()

            return

        self.tabs.removeTab(index)
        tab.deleteLater()

    # ========================================================
    # NAVIGATION AND GOOGLE SEARCH
    # ========================================================

    def navigate(self):

        text = self.address.text().strip()

        if not text:
            return

        if " " in text or "." not in text:

            url = QUrl(
                "https://www.google.com/search?q="
                + quote_plus(text)
            )

        else:

            if not text.startswith(
                ("http://", "https://")
            ):
                text = "https://" + text

            url = QUrl.fromUserInput(text)

        self.current_view().setUrl(url)

    def focus_address(self):

        self.address.setFocus()
        self.address.selectAll()

    # ========================================================
    # SPLIT SCREEN
    # ========================================================

    def toggle_split(self):

        tab = self.current_tab()
        tab.toggle_split()

        self.split_button.setText(
            "◫ Close Split"
            if tab.secondary
            else "◫ Split"
        )

    # ========================================================
    # BROWSING HISTORY
    # ========================================================

    def page_finished(self, view, ok):

        if ok and not self.incognito:
            url = view.url().toString()

            if url.startswith(("http://", "https://")):
                self.record_history(
                    url, view.title() or url
                )

        mode = "INCOGNITO" if self.incognito else "NORMAL MODE"

        self.status.setText(
            mode + (" • PAGE READY" if ok else " • PAGE FAILED")
        )

    def record_history(self, url, title):

        if self.incognito or not self.history_db:
            return

        if not url.startswith(("http://", "https://")):
            return

        try:
            self.history_db.execute(
                """
                INSERT INTO history (url, title, visited)
                VALUES (?, ?, ?)
                """,
                (url, title or url, time.time())
            )

            self.history_db.commit()

        except sqlite3.Error:
            pass

    def show_history(self):

        if self.incognito or not self.history_db:
            return

        dialog = QDialog(self)
        dialog.setWindowTitle("Vortex — Browsing History")
        dialog.resize(800, 500)

        layout = QVBoxLayout(dialog)

        search = QLineEdit()
        search.setPlaceholderText("Filter history...")
        layout.addWidget(search)

        listing = QListWidget()
        layout.addWidget(listing)

        def refresh():

            listing.clear()

            rows = self.history_db.execute(
                """
                SELECT url, title, visited
                FROM history
                ORDER BY visited DESC
                LIMIT 2000
                """
            ).fetchall()

            term = search.text().lower()

            for url, title, visited in rows:

                label = f"{title or url} — {url}"

                if term in label.lower():

                    item = QListWidgetItem(label)

                    item.setData(
                        Qt.ItemDataRole.UserRole,
                        url
                    )

                    listing.addItem(item)

        def open_item(item):

            self.current_view().setUrl(
                QUrl(item.data(Qt.ItemDataRole.UserRole))
            )

            dialog.accept()

        def clear_history():

            answer = QMessageBox.question(
                dialog,
                "Clear History",
                "Delete all saved browsing history?",
                QMessageBox.StandardButton.Yes
                | QMessageBox.StandardButton.No
            )

            if answer == QMessageBox.StandardButton.Yes:

                self.history_db.execute(
                    "DELETE FROM history"
                )

                self.history_db.commit()
                refresh()

        search.textChanged.connect(refresh)
        listing.itemDoubleClicked.connect(open_item)

        clear_button = QPushButton("Clear History")
        clear_button.clicked.connect(clear_history)

        layout.addWidget(clear_button)

        refresh()
        dialog.exec()

    # ========================================================
    # PASSWORD MANAGER
    # ========================================================

    def show_passwords(self):

        if self.incognito:
            return

        if not self.vault_ready:

            if not self.vault.unlock(self):
                return

            self.vault_ready = True

        dialog = QDialog(self)
        dialog.setWindowTitle("Vortex — Password Vault")
        dialog.resize(650, 430)

        layout = QVBoxLayout(dialog)

        listing = QListWidget()
        layout.addWidget(listing)

        def refresh():

            listing.clear()

            for entry in self.vault.entries:

                item = QListWidgetItem(
                    f"{entry['site']} | {entry['username']}"
                )

                listing.addItem(item)

        def add_password():

            form = QDialog(dialog)
            form.setWindowTitle("Save Password")

            fields = QFormLayout(form)

            site = QLineEdit(
                self.current_view().url().host()
            )

            username = QLineEdit()

            password = QLineEdit()
            password.setEchoMode(
                QLineEdit.EchoMode.Password
            )

            fields.addRow("Website:", site)
            fields.addRow("Username:", username)
            fields.addRow("Password:", password)

            buttons = QDialogButtonBox(
                QDialogButtonBox.StandardButton.Save
                | QDialogButtonBox.StandardButton.Cancel
            )

            buttons.accepted.connect(form.accept)
            buttons.rejected.connect(form.reject)

            fields.addRow(buttons)

            if form.exec() != QDialog.DialogCode.Accepted:
                return

            if not site.text().strip() or not password.text():

                QMessageBox.warning(
                    dialog,
                    "Missing Details",
                    "Website and password are required."
                )

                return

            entry = {
                "site": site.text().strip(),
                "username": username.text(),
                "password": password.text()
            }

            self.vault.entries.append(entry)

            if self.vault.save():
                refresh()

            else:

                self.vault.entries.pop()

                QMessageBox.warning(
                    dialog,
                    "Save Failed",
                    "Could not save the encrypted vault."
                )

        def copy_password():

            row = listing.currentRow()

            if row < 0:
                return

            answer = QMessageBox.question(
                dialog,
                "Copy Password",
                "Copy this password to the clipboard? "
                "Other applications may be able to read "
                "clipboard contents.",
                QMessageBox.StandardButton.Yes
                | QMessageBox.StandardButton.No
            )

            if answer == QMessageBox.StandardButton.Yes:

                QApplication.clipboard().setText(
                    self.vault.entries[row]["password"]
                )

        def delete_password():

            row = listing.currentRow()

            if row < 0:
                return

            answer = QMessageBox.question(
                dialog,
                "Delete Password",
                "Delete this saved login?",
                QMessageBox.StandardButton.Yes
                | QMessageBox.StandardButton.No
            )

            if answer != QMessageBox.StandardButton.Yes:
                return

            removed = self.vault.entries.pop(row)

            if not self.vault.save():

                self.vault.entries.insert(row, removed)

                QMessageBox.warning(
                    dialog,
                    "Delete Failed",
                    "Could not update the vault."
                )

            refresh()

        buttons = QHBoxLayout()

        add_button = QPushButton("Add Password")
        copy_button = QPushButton("Copy Password")
        delete_button = QPushButton("Delete")

        add_button.clicked.connect(add_password)
        copy_button.clicked.connect(copy_password)
        delete_button.clicked.connect(delete_password)

        buttons.addWidget(add_button)
        buttons.addWidget(copy_button)
        buttons.addWidget(delete_button)

        layout.addLayout(buttons)

        refresh()
        dialog.exec()

    # ========================================================
    # INCOGNITO MODE
    # ========================================================

    def open_incognito(self):

        if self.incognito:

            self.close()
            return

        window = VortexBrowser(incognito=True)

        # Keep a reference so Python doesn't destroy the window.
        INCOGNITO_WINDOWS.append(window)

        window.setAttribute(
            Qt.WidgetAttribute.WA_DeleteOnClose,
            True
        )

        window.destroyed.connect(
            lambda: INCOGNITO_WINDOWS.remove(window)
            if window in INCOGNITO_WINDOWS else None
        )

        window.show()

    # ========================================================
    # QUICK NOTES
    # ========================================================

    def toggle_notes(self):

        self.notes.setVisible(
            not self.notes.isVisible()
        )

    # ========================================================
    # CLEANUP
    # ========================================================

    def closeEvent(self, event):

        # Notes are never written to a file.
        self.notes.clear()

        # Close database connection.
        if self.history_db:

            self.history_db.close()
            self.history_db = None

        # Clear in-memory browser caches and visited links.
        self.profile.clearHttpCache()
        self.profile.clearAllVisitedLinks()

        # Delete tabs and their pages.
        self.tabs.clear()

        event.accept()


