class BrowserView(QWebEngineView):

    def __init__(self, profile, owner):
        super().__init__()

        self.owner = owner
        self.setPage(QWebEnginePage(profile, self))
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)

    def focusInEvent(self, event):
        super().focusInEvent(event)
        self.owner.set_active(self)


# ============================================================
# BROWSER TAB AND SPLIT SCREEN
# ============================================================

class BrowserTab(QWidget):

    def __init__(self, profile, window):
        super().__init__()

        self.window = window
        self.profile = profile
        self.secondary = None
        self.active = None

        self.splitter = QSplitter(
            Qt.Orientation.Horizontal
        )

        self.primary = self.make_view()
        self.splitter.addWidget(self.primary)

        self.active = self.primary

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.addWidget(self.splitter)

    def make_view(self):

        view = BrowserView(self.profile, self)

        view.urlChanged.connect(
            lambda url, v=view: self.url_changed(v, url)
        )

        view.titleChanged.connect(
            lambda title, v=view: self.title_changed(v, title)
        )

        view.loadFinished.connect(
            lambda ok, v=view: self.window.page_finished(v, ok)
        )

        return view

    def set_active(self, view):

        self.active = view

        if self.window.tabs.currentWidget() is self:
            self.window.address.setText(
                view.url().toString()
            )

    def url_changed(self, view, url):

        if (
            self.window.tabs.currentWidget() is self
            and self.active is view
        ):
            self.window.address.setText(url.toString())

    def title_changed(self, view, title):

        if view is self.primary:
            self.window.update_tab_title(self, title)

    def toggle_split(self):

        if self.secondary:

            old_view = self.secondary
            self.secondary = None

            old_view.setParent(None)
            old_view.deleteLater()

            self.active = self.primary
            self.primary.setFocus()

            self.window.address.setText(
                self.primary.url().toString()
            )

        else:

            self.secondary = self.make_view()

            self.splitter.addWidget(self.secondary)
            self.splitter.setSizes([650, 650])

            self.secondary.setUrl(QUrl(HOME_URL))
            self.secondary.setFocus()


# ============================================================
# MAIN BROWSER
# ============================================================

class VortexBrowser(QMainWindow):

    def __init__(self, incognito=False):

        super().__init__()

        self.incognito = incognito
        self.vault = PasswordVault()
        self.vault_ready = False
        self.history_db = None
        self.incognito_window = None

        mode = "Incognito" if incognito else "Normal"

        self.setWindowTitle(f"VORTEX — {mode} Mode")
        self.resize(1400, 900)
        self.setMinimumSize(850, 600)

        # ----------------------------------------------------
        # Browser profiles
        # ----------------------------------------------------

        if incognito:

            # No persistent storage path: off-the-record profile.
            self.profile = QWebEngineProfile(self)

            self.profile.setHttpCacheType(
                QWebEngineProfile.HttpCacheType.NoCache
            )

            self.profile.setPersistentCookiesPolicy(
                QWebEngineProfile.PersistentCookiesPolicy
                .NoPersistentCookies
            )

        else:

            self.profile = QWebEngineProfile(
                "VortexNormal", self
            )

            self.profile.setPersistentStoragePath(
                PROFILE_DIR
            )

            self.profile.setCachePath(
                CACHE_DIR
            )

            self.profile.setHttpCacheType(
                QWebEngineProfile.HttpCacheType.DiskHttpCache
            )

            self.profile.setPersistentCookiesPolicy(
                QWebEngineProfile.PersistentCookiesPolicy
                .AllowPersistentCookies
            )

            self.history_db = sqlite3.connect(HISTORY_DB)

            self.history_db.execute("""
                CREATE TABLE IF NOT EXISTS history (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    url TEXT NOT NULL,
                    title TEXT,
                    visited REAL NOT NULL
                )
            """)

            self.history_db.commit()

        # ----------------------------------------------------
        # Main layout
        # ----------------------------------------------------

        central = QWidget()
        self.setCentralWidget(central)

        layout = QVBoxLayout(central)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)

        # Header
        header = QHBoxLayout()
        header.setContentsMargins(16, 12, 16, 12)

        logo = QLabel("VORTEX")
        logo.setObjectName("logo")

        self.mode_label = QLabel(
            "INCOGNITO SESSION"
            if incognito
            else "PRIVATE BROWSING CONTROLS"
        )

        self.mode_label.setObjectName("tagline")

        header.addWidget(logo)
        header.addWidget(self.mode_label)
        header.addStretch()

        self.split_button = self.button("◫ Split", True)
        self.split_button.clicked.connect(self.toggle_split)
        header.addWidget(self.split_button)

        if not incognito:

            history_button = self.button("History")
            history_button.clicked.connect(self.show_history)
            header.addWidget(history_button)

            password_button = self.button("Passwords")
            password_button.clicked.connect(self.show_passwords)
            header.addWidget(password_button)

        self.incognito_button = self.button(
            "Exit Incognito" if incognito else "Incognito"
        )

        self.incognito_button.clicked.connect(
            self.open_incognito
        )

        header.addWidget(self.incognito_button)
        layout.addLayout(header)

        # Navigation bar
        nav = QHBoxLayout()
        nav.setContentsMargins(12, 6, 12, 10)
        nav.setSpacing(7)

        back = self.button("←")
        forward = self.button("→")
        reload_button = self.button("↻")
        home = self.button("⌂")
        new_tab_button = self.button("+", True)

        back.clicked.connect(
            lambda: self.current_view().back()
        )

        forward.clicked.connect(
            lambda: self.current_view().forward()
        )

        reload_button.clicked.connect(
            lambda: self.current_view().reload()
        )

        home.clicked.connect(
            lambda: self.current_view().setUrl(QUrl(HOME_URL))
        )

        new_tab_button.clicked.connect(self.new_tab)

        self.address = QLineEdit()
        self.address.setPlaceholderText(
            "Search Google or enter a website..."
        )
        self.address.setClearButtonEnabled(True)
        self.address.returnPressed.connect(self.navigate)

        for widget in (
            back, forward, reload_button, home
        ):
            nav.addWidget(widget)

        nav.addWidget(self.address, 1)
        nav.addWidget(new_tab_button)
        layout.addLayout(nav)

        # Tabs
        self.tabs = QTabWidget()
        self.tabs.setDocumentMode(True)
        self.tabs.setMovable(True)
        self.tabs.setTabsClosable(True)

        self.tabs.currentChanged.connect(
            self.update_address
        )

        self.tabs.tabCloseRequested.connect(
            self.close_tab
        )

        layout.addWidget(self.tabs, 1)

        # Temporary notes
        self.notes = QTextEdit()
        self.notes.setPlaceholderText(
            "Temporary quick notes for this session..."
        )
        self.notes.setMaximumHeight(95)
        self.notes.hide()

        layout.addWidget(self.notes)

        # Footer
        footer = QHBoxLayout()
        footer.setContentsMargins(14, 7, 14, 7)

        status_text = (
            "INCOGNITO • NORMAL HISTORY DISABLED"
            if incognito
            else "NORMAL MODE • HISTORY ENABLED"
        )

        self.status = QLabel(status_text)
        self.status.setObjectName("status")

        footer.addWidget(self.status)
        footer.addStretch()

        notes_button = self.button("Quick Notes")

        notes_button.clicked.connect(
            self.toggle_notes
        )

        footer.addWidget(notes_button)
        layout.addLayout(footer)

        # Keyboard shortcuts
        QShortcut(
            QKeySequence("Ctrl+L"),
            self,
            activated=self.focus_address
        )

        QShortcut(
            QKeySequence("Ctrl+T"),
            self,
            activated=self.new_tab
        )

        QShortcut(
            QKeySequence("Ctrl+W"),
            self,
            activated=self.close_current_tab
        )

        QShortcut(
            QKeySequence("Ctrl+R"),
            self,
            activated=lambda: self.current_view().reload()
        )

        QShortcut(
            QKeySequence("Ctrl+Shift+S"),
            self,
            activated=self.toggle_split
        )

        QShortcut(
            QKeySequence("Ctrl+Shift+N"),
            self,
            activated=self.open_incognito
        )

        self.apply_theme()
        self.new_tab()

